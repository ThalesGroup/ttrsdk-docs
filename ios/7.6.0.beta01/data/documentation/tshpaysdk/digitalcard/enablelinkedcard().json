{"kind":"symbol","identifier":{"url":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/enableLinkedCard()","interfaceLanguage":"swift"},"abstract":[{"text":"Enables the dynamic link between this primary card and its linked secondary card.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK","doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard"]]},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"TSHPaySDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enableLinkedCard","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"symbolKind":"method","externalID":"s:9TSHPaySDK11DigitalCardC012enableLinkedD0yyYaKF","role":"symbol","title":"enableLinkedCard()","extendedModule":"TSHPaySDK"},"variants":[{"paths":["\/documentation\/tshpaysdk\/digitalcard\/enablelinkedcard()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enableLinkedCard","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When enabled, both the primary and secondary cards will be presented during contactless payment"},{"type":"text","text":" "},{"type":"text","text":"transactions. The payment terminal will select the appropriate card based on the transaction"},{"type":"text","text":" "},{"type":"text","text":"requirements. This operation updates the link state in secure storage and propagates the change"},{"type":"text","text":" "},{"type":"text","text":"to the payment system."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""}]}],"type":"aside"},{"style":"note","name":"Note","content":[{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/Error\/cardNotLinked","type":"reference"},{"text":" if this card is not currently linked to a secondary card.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/linkCard(_:)","type":"reference"},{"text":" to establish a link first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/Error\/clientError(_:)","type":"reference"},{"text":" if the operation fails due to an error in storage or","type":"text"},{"text":" ","type":"text"},{"text":"the default card cannot be reset (because this is the default card).","type":"text"}]}]}]}],"type":"aside"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If this card is currently set as the default card, it will automatically be reset as the default card"},{"type":"text","text":" "},{"type":"text","text":"after the link is enabled. This ensures that the updated PPSE (Proximity Payment System Environment)"},{"type":"text","text":" "},{"type":"text","text":"data is properly propagated to the payment system. If this reset operation fails, the link"},{"type":"text","text":" "},{"type":"text","text":"state will be rolled back to disabled."}]}],"type":"aside"},{"style":"note","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/disableLinkedCard()"},{"type":"text","text":" to temporarily disable the link without unlinking the cards."}]}],"type":"aside"},{"style":"note","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/unlinkCard()"},{"type":"text","text":" to permanently remove the link between cards."}]}],"type":"aside"},{"style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"7.6.0"}]}],"type":"aside"}],"kind":"content"}],"references":{"doc://TSHPaySDK/documentation/TSHPaySDK/DigitalCard":{"fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"DigitalCard"}],"navigatorTitle":[{"kind":"identifier","text":"DigitalCard"}],"abstract":[{"text":"DigitalCard Class","type":"text"},{"text":" ","type":"text"},{"text":"Implementation of the ","type":"text"},{"code":"DigitalCard","type":"codeVoice"},{"text":" retrieved from the  ","type":"text"},{"code":"DigitalCardManager","type":"codeVoice"},{"text":" module.","type":"text"}],"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard","type":"topic","url":"\/documentation\/tshpaysdk\/digitalcard","title":"DigitalCard","kind":"symbol","role":"symbol"},"doc://TSHPaySDK/documentation/TSHPaySDK/DigitalCard/linkCard(_:)":{"url":"\/documentation\/tshpaysdk\/digitalcard\/linkcard(_:)","title":"linkCard(_:)","role":"symbol","abstract":[{"text":"Links a secondary digital card to the primary card.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/linkCard(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"linkCard"},{"kind":"text","text":"("},{"preciseIdentifier":"s:9TSHPaySDK11DigitalCardC","kind":"typeIdentifier","text":"DigitalCard"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text",