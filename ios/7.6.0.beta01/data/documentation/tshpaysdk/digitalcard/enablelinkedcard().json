d","type":"text"}],"title":"DigitalCard.Error.cardNotLinked","type":"topic","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cardNotLinked","kind":"identifier"}]},"doc://TSHPaySDK/documentation/TSHPaySDK/DigitalCard/Error/clientError(_:)":{"kind":"symbol","identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/Error\/clientError(_:)","abstract":[{"type":"text","text":"Client error."}],"url":"\/documentation\/tshpaysdk\/digitalcard\/error\/clienterror(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"clientError"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"role":"symbol","title":"DigitalCard.Error.clientError(_:)","type":"topic"},"doc://TSHPaySDK/documentation/TSHPaySDK/DigitalCard/enableLinkedCard()":{"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/enableLinkedCard()","title":"enableLinkedCard()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enableLinkedCard"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"url":"\/documentation\/tshpaysdk\/digitalcard\/enablelinkedcard()","abstract":[{"type":"text","text":"Enables the dynamic link between this primary card and its linked secondary card."}]}}}