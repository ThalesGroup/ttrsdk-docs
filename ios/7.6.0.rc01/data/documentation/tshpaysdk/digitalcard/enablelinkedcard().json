{"abstract":[{"text":"Enables the dynamic link between this main card and its linked alternate card.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enableLinkedCard","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"When enabled, both the main and alternate cards will be presented during contactless payment","type":"text"},{"text":" ","type":"text"},{"text":"transactions. The payment terminal will select the appropriate card based on the transaction","type":"text"},{"text":" ","type":"text"},{"text":"requirements. This operation updates the link state in secure storage and propagates the change","type":"text"},{"text":" ","type":"text"},{"text":"to the payment system.","type":"text"}]},{"type":"aside","name":"Throws","style":"note","content":[{"inlineContent":[{"type":"text","text":""}],"type":"paragraph"}]},{"type":"aside","name":"Note","style":"note","content":[{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/Error\/cardNotLinked","isActive":true,"type":"reference"},{"text":" if this card is not currently linked to an alternate card.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/linkCard(_:)","isActive":true,"type":"reference"},{"text":" to establish a link first.","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/Error\/clientError(_:)","type":"reference","isActive":true},{"text":" if the operation fails due to an error in storage or","type":"text"},{"text":" ","type":"text"},{"text":"the default card cannot be reset (because this is the default card).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"If this card is currently set as the default card, it will automatically be reset as the default card"},{"type":"text","text":" "},{"type":"text","text":"after the link is enabled. This ensures that the updated PPSE (Proximity Payment System Environment)"},{"type":"text","text":" "},{"type":"text","text":"data is properly propagated to the payment system. If this reset operation fails, the link"},{"type":"text","text":" "},{"type":"text","text":"state will be rolled back to disabled."}],"type":"paragraph"}]},{"type":"aside","name":"See Also","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/disableLinkedCard()","isActive":true,"type":"reference"},{"text":" to temporarily disable the link without unlinking the cards.","type":"text"}],"type":"paragraph"}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/unlinkCard()","type":"reference","isActive":true},{"type":"text","text":" to permanently remove the link between cards."}]}],"type":"aside","name":"See Also"},{"style":"note","content":[{"inlineContent":[{"text":"7.6.0","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Since"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tshpaysdk\/digitalcard\/enablelinkedcard()"]}],"sections":[],"identifier":{"url":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/enableLinkedCard()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK","doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/Di