{"hierarchy":{"paths":[["doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK","doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"disableLinkedCard","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"When disabled, only the primary card will be presented during contactless payment transactions."},{"type":"text","text":" "},{"type":"text","text":"The link between the cards remains intact and can be re-enabled using "},{"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/enableLinkedCard()","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This operation updates the link state in secure storage and propagates the change to the payment system."}],"type":"paragraph"},{"style":"note","name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""}]}]},{"style":"note","name":"Note","type":"aside","content":[{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/Error\/cardNotLinked"},{"type":"text","text":" if this card is not currently linked to a secondary card."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/linkCard(_:)"},{"type":"text","text":" to establish a link first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/Error\/clientError(_:)"},{"type":"text","text":" if the operation fails due to storage errors or if"},{"type":"text","text":" "},{"type":"text","text":"re-setting the default card failsdue to an error in storage or"},{"type":"text","text":" "},{"type":"text","text":"the default card cannot be reset (because this is the default card)."},{"type":"text","text":" "},{"type":"text","text":"automatically be reset as"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"If this card is currently set as the default card, it will automatically be reset as the default card"},{"type":"text","text":" "},{"type":"text","text":"after the link is disabled. This ensures that the updated PPSE (Proximity Payment System Environment)"},{"type":"text","text":" "},{"type":"text","text":"data is properly propagated to the payment system. If this reset operation fails, the link"},{"type":"text","text":" "},{"type":"text","text":"state will be rolled back to enabled."}],"type":"paragraph"}]},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Disabling the link does not remove the linking between the cards. To permanently remove the link, use "},{"type":"reference","identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/unlinkCard()","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"style":"note","name":"See Also","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/enableLinkedCard()","isActive":true},{"type":"text","text":" to enable a previously disabled card link."}],"type":"paragraph"}]},{"style":"note","name":"See Also","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/unlinkCard()","isActive":true},{"type":"text","text":" to permanently remove the link between cards."}],"type":"paragraph"}]},{"style":"note","name":"Since","type":"aside","content":[{"inlineContent":[{"type":"text","text":"7.6.0"}],"type":"paragraph"}]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tshpaysdk\/digitalcard\/disablelinkedcard()"]}],"identifier":{"url":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/disableLinkedCard()","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"title":"disableLinkedCard()","externalID":"s:9TSHPaySDK11DigitalCardC013disableLinkedD0yyYaKF","role":"symbol","symbolKind":"method","extendedModule":"TSHPaySDK","modules":[{"name":"TSHPaySDK"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"disableLinkedCard"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"roleHeading":"Instance Method"},"abstract":[{"text":"Disables the dynamic link between this primary card and its linked secondary card.","type":"text"}],"references":{"doc://TSHPaySDK/documentation/TSHPaySDK":{"url":"\/documentation\/tshpaysdk","identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK","role":"collection","abstract":[],"title":"TSHPaySDK","type":"topic","kind":"symbol"},"doc://TSHPaySDK/documentation/TSHPaySDK/DigitalCard/Error/clientError(_:)":{"kind":"symbol","identifier":"doc:\/\/TSHPaySDK\/documentation\/TSHPaySDK\/DigitalCard\/Error\/clientError(_:)","abstract":[{"type":"text","text":"Client error."}],"url":"\/documentation\/tshpaysdk\/digitalcard\/error\/clienterror(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"clientError"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"role":"symbol","ti